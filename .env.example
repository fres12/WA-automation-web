# Isi dengan URL project Supabase kamu, contoh: https://xxxxx.supabase.co
SUPABASE_URL=

# PENTING: pakai anon key, JANGAN PERNAH pakai service_role key di VPS ini.
# anon key cuma bisa panggil RPC submit_form_request (insert-only, security definer).
# Ambil dari Supabase Dashboard > Project Settings > API > anon public
SUPABASE_ANON_KEY=

# Hanya untuk backend Node.js. Jangan pernah kirim ke browser atau commit ke git.
# Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Hanya untuk server. Jangan pernah masukkan key ini ke frontend atau commit ke git.
# Dipakai untuk cache wa_groups yang dilindungi RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Port yang dipakai Express (default 3000, sesuaikan sama reverse proxy Nginx di Hostinger)
PORT=3000
